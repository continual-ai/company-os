{
  "name": "Company OS",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "user": "ubuntu",
  "install": "pnpm install --frozen-lockfile",
  "start": "bash .cursor/start-postgres.sh",
  "ports": [
    {
      "name": "company-os",
      "port": 3002
    }
  ],
  "terminals": [
    {
      "name": "company-os",
      "command": "pnpm dev",
      "description": "Company OS at http://localhost:3002 (same as README: pnpm dev)"
    }
  ]
}
