// Build-time Worker configuration consumed by the Cloudflare Vite plugin.
// Runtime configuration (database, secrets, identity) is supplied as
// deploy-time bindings by the hosting platform and must never appear here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "company-os",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": ["APP_SECRET", "DATABASE_URL"] },
  "observability": { "enabled": true },
}
