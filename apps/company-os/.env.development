# Committed non-production defaults for the central app.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/company_os
APP_NAMESPACE=company-os
APP_SECRET=company-os-application-secret-local-development-only
AUTH_MODE=local
AUTH_LOCAL_COOKIE_NAME=company-os-local-identity
AUTH_LOCAL_ISSUER=urn:company-os:local
