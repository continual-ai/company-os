{
  "name": "company-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./model": "./src/app.model.ts",
    "./metadata": "./src/model-metadata.ts"
  },
  "scripts": {
    "build": "vite build",
    "db:check": "tsx --import ./tools/environment.ts tools/generate-db-schema.ts --check",
    "db:dump": "tsx --import ./tools/environment.ts tools/db-dump.ts",
    "db:generate": "tsx --import ./tools/environment.ts tools/generate-db-schema.ts",
    "db:migrate": "tsx --import ./tools/environment.ts tools/db-migrate.ts",
    "db:reset": "tsx --import ./tools/environment.ts tools/db-reset.ts",
    "db:seed": "tsx --import ./tools/environment.ts tools/db-seed.ts",
    "deploy": "tsx --import ./tools/environment.ts tools/db-migrate.ts --if-configured && continual deploy",
    "dev": "vite dev --port 3002 --host 0.0.0.0",
    "lint": "oxlint .",
    "model:check": "tsx --import ./tools/environment.ts tools/lint-model.ts && tsx tools/check-model-boundaries.ts",
    "preview": "pnpm build && vite preview --port 3102 --host 0.0.0.0",
    "reset": "pnpm run db:reset",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@company/engineering": "workspace:*",
    "@company/marketing": "workspace:*",
    "@company/notes": "workspace:*",
    "@company/runtime": "workspace:*",
    "@company/sales": "workspace:*",
    "@continual/sdk": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "catalog:",
    "effect": "catalog:",
    "jose": "6.2.12",
    "lucide-react": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@continual/tanstack-start": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxc-parser": "^0.148.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "continual": {
    "key": "company-os",
    "name": "Company OS",
    "database": true
  }
}
