{
  "name": "company-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx tools/db-migrate.ts",
    "db:reset": "tsx tools/db-reset.ts",
    "deploy": "echo \"No deploy implemented for company-os.\"",
    "dev": "vite dev --port 3002",
    "lint": "oxlint .",
    "preview": "vite preview --port 3102",
    "reset": "pnpm run db:reset",
    "setup": "tsx tools/setup.ts && pnpm run db:migrate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@company/model": "workspace:*",
    "@company/postgres": "workspace:*",
    "@company/runtime": "workspace:*",
    "@company/ui": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
