{
  "name": "company-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#modules/*": "./src/modules/*.ts",
    "#root": "./src/model-root.ts"
  },
  "exports": {
    "./model": "./src/model.ts",
    "./metadata": "./src/model-metadata.ts"
  },
  "scripts": {
    "build": "vite build",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "tsx tools/generate-db-schema.ts && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx tools/db-migrate.ts",
    "db:reset": "tsx tools/db-reset.ts",
    "db:seed": "tsx tools/db-seed.ts",
    "deploy": "tsx tools/db-migrate.ts --if-configured && continual deploy",
    "dev": "vite dev --port 3002 --host 0.0.0.0",
    "lint": "oxlint .",
    "model:check": "tsx tools/lint-model.ts && tsx tools/check-model-boundaries.ts && tsx tools/generate-db-schema.ts --check",
    "preview": "pnpm build && vite preview --port 3102 --host 0.0.0.0",
    "reset": "pnpm run db:reset",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@company/postgres": "workspace:*",
    "@company/runtime": "workspace:*",
    "@company/ui": "workspace:*",
    "@continual/sdk": "catalog:",
    "@dnd-kit/react": "^0.5.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "^3.14.10",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "file-type": "22.0.2",
    "image-size": "^2.0.2",
    "lucide-react": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@continual/tanstack-start": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "oxc-parser": "^0.148.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "continual": {
    "key": "company-os",
    "name": "Company OS",
    "database": true
  }
}
