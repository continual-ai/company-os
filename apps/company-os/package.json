{
  "name": "company-os",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./model": "./src/app.model.ts",
    "./client": "./src/runtime/client/create-client.ts",
    "./config": "./src/app.config.ts"
  },
  "scripts": {
    "build": "vite build",
    "db:check": "tsx tools/check-db-schema.ts",
    "db:dump": "tsx tools/db-dump.ts",
    "db:generate": "tsx tools/db-generate.ts",
    "db:migrate": "tsx tools/db-migrate.ts",
    "db:seed": "tsx tools/db-seed.ts",
    "deploy": "continual deploy",
    "dev": "vite dev --port 3002 --host 0.0.0.0",
    "lint": "oxlint .",
    "model:check": "tsx tools/lint-model.ts",
    "preview": "pnpm build && vite preview --port 3102 --host 0.0.0.0",
    "reset": "tsx tools/db-reset.ts && pnpm db:seed",
    "test": "vitest run --project unit --project database",
    "test:agents:live": "vitest run --project agents-live",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@company/ui": "workspace:*",
    "@continual/sdk": "catalog:",
    "@dnd-kit/react": "^0.5.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@openai/codex-sdk": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "^3.14.10",
    "effect": "catalog:",
    "file-type": "22.0.2",
    "image-size": "^2.0.2",
    "jose": "6.2.12",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typeid-js": "catalog:"
  },
  "devDependencies": {
    "@continual/tanstack-start": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "continual": {
    "key": "company-os",
    "name": "Company OS",
    "database": true
  }
}
