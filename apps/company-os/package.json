{
  "name": "company-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:schema:generate": "auth generate --config auth.cli.ts --output src/server/auth/auth-schema.generated.ts --yes && oxfmt src/server/auth/auth-schema.generated.ts",
    "build": "vite build",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:deploy": "tsx --env-file-if-exists=.env.local src/server/database/deploy.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:custom": "drizzle-kit generate --custom --config drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/database/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local src/server/database/reset.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/server/database/seed.ts",
    "dev": "vite dev --port 3002",
    "preview": "vite preview --port 3102",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@company/model": "workspace:*",
    "@company/postgres": "workspace:*",
    "@company/runtime": "workspace:*",
    "@company/ui": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@effect/sql-pglite": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
