{
  "name": "company-os",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./model": "./src/app.model.ts",
    "./client": "./src/runtime/client/create-client.ts",
    "./config": "./src/app.config.ts",
    "./ui/*": "./src/runtime/ui/components/*.tsx",
    "./styles.css": "./src/runtime/ui/styles/globals.css"
  },
  "scripts": {
    "build": "vite build",
    "db:check": "tsx tools/generate-db-schema.ts --check",
    "db:generate": "tsx tools/generate-db-schema.ts",
    "db:migrate": "tsx tools/db-migrate.ts",
    "db:reset": "tsx tools/db-reset.ts",
    "db:seed": "tsx tools/db-seed.ts",
    "deploy": "tsx tools/db-migrate.ts --if-configured && continual deploy",
    "dev": "vite dev --port 3002 --host 0.0.0.0",
    "lint": "oxlint .",
    "model:check": "tsx tools/lint-model.ts",
    "preview": "pnpm build && vite preview --port 3102 --host 0.0.0.0",
    "reset": "pnpm run db:reset",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ui:add": "tsx tools/ui-add.ts",
    "ui:remove": "tsx tools/ui-remove.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@continual/sdk": "catalog:",
    "@dnd-kit/react": "^0.5.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@shikijs/core": "catalog:",
    "@shikijs/engine-javascript": "catalog:",
    "@shikijs/langs": "catalog:",
    "@shikijs/themes": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "date-fns": "catalog:",
    "effect": "catalog:",
    "file-type": "22.0.2",
    "image-size": "^2.0.2",
    "jose": "6.2.12",
    "lucide-react": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "react-phone-number-input": "catalog:",
    "remark-gfm": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "typeid-js": "catalog:"
  },
  "devDependencies": {
    "@continual/tanstack-start": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "continual": {
    "key": "company-os",
    "name": "Company OS",
    "database": true
  }
}
