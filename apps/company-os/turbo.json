{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "deploy": {
      "cache": false,
      "passThroughEnv": [
        "CONTINUAL_API_KEY",
        "CONTINUAL_BRANCH_ID",
        "CONTINUAL_EXECUTION_TOKEN",
        "CONTINUAL_PROJECT_ID",
        "CONTINUAL_URL",
        "DATABASE_MAX_CONNECTIONS",
        "DATABASE_SCHEMA",
        "DATABASE_URL"
      ]
    },
    "db:check": {},
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**", ".env"],
      "passThroughEnv": [
        "DATABASE_MAX_CONNECTIONS",
        "DATABASE_SCHEMA",
        "DATABASE_URL"
      ]
    },
    "model:check": {},
    "db:migrate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_MAX_CONNECTIONS",
        "DATABASE_SCHEMA",
        "DATABASE_URL"
      ],
      "dependsOn": ["db:generate"]
    },
    "db:generate": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:migrate"]
    },
    "reset": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_MAX_CONNECTIONS",
        "DATABASE_SCHEMA",
        "DATABASE_URL",
        "APP_SECRET",
        "AUTH_*",
        "IDENTITY_PROVIDER",
        "NODE_ENV"
      ]
    }
  }
}
