# Copy this file to apps/company-os/.env.local for local development.
# Unprefixed values are server-only. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/company_os
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=
AUTH_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_NAME=Google
# Optional. When blank, the first verified User to sign in becomes administrator.
AUTH_BOOTSTRAP_EMAIL=

# VITE_ values are compiled into browser code and must never contain secrets.
VITE_COMPANY_OS_URL=
