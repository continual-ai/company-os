# Copy this file to apps/company-os/.env.local for local development.
# Unprefixed values are server-only. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/company_os

# Local development JIT-provisions this User and grants the configured role.
AUTH_MODE=local
AUTH_LOCAL_SUBJECT=developer
AUTH_LOCAL_NAME=Local developer
AUTH_LOCAL_EMAIL=developer@company.test
AUTH_JIT_ROLE=administrator

# Continual or another standards-oriented gateway can send a short-lived signed
# assertion. AUTH_JIT_ROLE is deliberately required for every deployed mode.
# AUTH_MODE=jwt
# AUTH_JWT_HEADER=x-company-identity
# AUTH_JWT_ISSUER=https://identity.example.com
# AUTH_JWT_AUDIENCE=company-os
# AUTH_JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AUTH_JWT_ALGORITHMS=RS256,ES256,EdDSA
# AUTH_JWT_CLOCK_TOLERANCE_SECONDS=30
# AUTH_JWT_MAX_AGE=10m
# AUTH_JWT_KIND_CLAIM=identity_type
# AUTH_JWT_DEFAULT_IDENTITY_KIND=user
# AUTH_JIT_ROLE=operator

# Google IAP has a strict built-in profile. Copy the Signed Header JWT Audience
# from IAP rather than using a client ID or application URL.
# AUTH_MODE=google-iap
# AUTH_IAP_AUDIENCE=/projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
# AUTH_JIT_ROLE=operator

# VITE_ values are compiled into browser code and must never contain secrets.
VITE_COMPANY_OS_URL=
