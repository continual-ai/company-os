# Every key the application reads. Development needs none of them: the defaults in
# src/app/server/config.ts cover the local database, secret, and administrator.
# Put local overrides in .env.local (this App or the repository root); injected
# environment takes precedence over both. Deployments set values explicitly.
# Unprefixed values are server-only. Never commit deployment credentials.
# DATABASE_URL=postgresql://localhost:5432/company_os
# Two is the safe default for request-scoped Workers. Long-lived servers may raise it.
# DATABASE_MAX_CONNECTIONS=10
# Hosted deployments supply the shared schema all company apps resolve into.
# Unset locally, unqualified names resolve to public.
# DATABASE_SCHEMA=
# Required in every deployment; development uses a known local value.
# APP_SECRET=

# Continual injects these values into managed preview environments. Published
# and proxied App requests also require CONTINUAL_URL to pin the verifier.
# They receive signed runtime headers from the
# Continual gateway. The App creates a role-assignable principal projection,
# but does not configure a second credential or session system.
# CONTINUAL_URL=https://continual.example.com
# CONTINUAL_EXECUTION_TOKEN=

# VITE_ values are compiled into browser code and must never contain secrets.
# Vite reads them from .env.local; the dev server falls back to its own origin.
# VITE_APP_URL=https://app.example.com

# Explicit first-administrator bootstrap for a deployed installation. Configure
# before this subject's first sign-in. Existing role assignments are preserved.
# AUTH_BOOTSTRAP_ISSUER=continual
# AUTH_BOOTSTRAP_SUBJECT=us_your_verified_subject
# New identities otherwise receive no role. Opt into ordinary operator grants:
# AUTH_DEFAULT_ROLE=operator

# Leave unset for the minimal app; use sales or demo with a separate database.

# Standalone production identity from an organization JWT gateway:
# IDENTITY_PROVIDER=jwt
# AUTH_JWT_ISSUER=https://identity.example.com/
# AUTH_JWT_AUDIENCE=company-os
# AUTH_JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AUTH_BOOTSTRAP_ISSUER=https://identity.example.com/
# AUTH_BOOTSTRAP_SUBJECT=the-initial-administrator-subject
