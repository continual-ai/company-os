# pnpm setup copies this file to .env for local development.
# Unprefixed values are server-only. Never commit deployment credentials.
# Include an explicit user when the dev server runs inside workerd
# (CONTINUAL_WORKERD_DEV=1 or preview), which has no operating-system
# username to fall back to.
DATABASE_URL=postgresql://127.0.0.1:5432/company_os
# Hosted deployments supply the shared schema all company apps resolve into.
# Unset locally, unqualified names resolve to public.
# DATABASE_SCHEMA=
# This known value is only for local development. Replace it in every deployment.
APP_SECRET=company-os-application-secret-local-development-only

# Local authentication is the default in development and needs no configuration.
# Optional AUTH_LOCAL_* values customize its administrator profile.
# AUTH_LOCAL_SUBJECT=developer
# AUTH_LOCAL_NAME=Local developer
# AUTH_LOCAL_EMAIL=developer@company.test

# Continual or another standards-oriented gateway can send a short-lived signed
# assertion. AUTH_JIT_ROLE is deliberately required for every deployed mode.
# AUTH_MODE=jwt
# AUTH_JWT_HEADER=x-company-identity
# AUTH_JWT_ISSUER=https://identity.example.com
# AUTH_JWT_AUDIENCE=company-os
# AUTH_JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AUTH_JWT_ALGORITHMS=RS256,ES256,EdDSA
# AUTH_JWT_CLOCK_TOLERANCE_SECONDS=30
# AUTH_JWT_MAX_AGE=10m
# AUTH_JWT_KIND_CLAIM=identity_type
# AUTH_JWT_DEFAULT_IDENTITY_KIND=user
# The trusted gateway owns this same-origin route and its login session.
# AUTH_SIGN_OUT_PATH=/_continual/sign-out
# AUTH_JIT_ROLE=operator

# Google IAP has a strict built-in profile. Copy the Signed Header JWT Audience
# from IAP rather than using a client ID or application URL.
# AUTH_MODE=google-iap
# AUTH_IAP_AUDIENCE=/projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
# External-identity IAP defaults to /?gcp-iap-mode=GCIP_SIGNOUT. Override
# this for another IAP session configuration or proxy contract.
# AUTH_SIGN_OUT_PATH=/?gcp-iap-mode=GCIP_SIGNOUT
# AUTH_JIT_ROLE=operator

# VITE_ values are compiled into browser code and must never contain secrets.
VITE_COMPANY_OS_URL=http://localhost:3002
