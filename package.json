{
  "name": "company-os-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm format:check && pnpm lint && pnpm deadcode && pnpm typecheck && pnpm -r --if-present db:check",
    "create:app": "tsx tools/create-app.ts",
    "deadcode": "knip",
    "dev": "pnpm template:setup && turbo dev --filter=@company-template/company-os",
    "dev:all": "pnpm template:setup && turbo dev --filter='./templates/*'",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && turbo boundaries",
    "lint:fix": "oxlint --fix . && turbo boundaries",
    "template:setup": "docker compose up -d --wait template-postgres && pnpm --filter @company-template/company-os db:deploy",
    "test": "turbo test",
    "typecheck": "tsc --noEmit && turbo typecheck",
    "ui:add": "pnpm --filter @company/ui exec shadcn add"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0 <12.0.0"
  }
}
