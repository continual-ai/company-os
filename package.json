{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "continual": "node packages/continual/cli/src/bin.mjs",
    "dev": "turbo dev --filter='./apps/*' --filter=@continual/cli",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && turbo boundaries",
    "lint:fix": "oxlint --fix . && turbo boundaries",
    "studio": "pnpm continual studio",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "unrs-resolver"
    ]
  }
}
