{
  "name": "company-os-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm format:check && pnpm lint && pnpm deadcode && pnpm typecheck && pnpm --filter company-os db:check",
    "deadcode": "knip",
    "dev": "turbo dev --filter='./apps/*'",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && turbo boundaries",
    "lint:fix": "oxlint --fix . && turbo boundaries",
    "test": "turbo test",
    "typecheck": "tsc --noEmit && turbo typecheck",
    "ui:add": "pnpm --filter @company/ui exec shadcn add"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.10",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "knip": {
    "workspaces": {
      "apps/company-os": {
        "entry": [
          "auth.cli.ts"
        ],
        "ignoreIssues": {
          "src/server/auth/auth-schema.generated.ts": [
            "exports"
          ]
        }
      }
    }
  }
}
