{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "continual": "node packages/continual/cli/src/bin.mjs",
    "dev": "turbo dev --filter='./apps/*' --filter=@continual/cli",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check": "pnpm check:boundaries && pnpm format:check && pnpm lint && pnpm typecheck",
    "check:boundaries": "turbo boundaries && node scripts/check-boundaries.mjs",
    "format:check": "prettier --check .",
    "studio": "pnpm continual studio"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@acme/model": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "unrs-resolver"
    ]
  }
}
