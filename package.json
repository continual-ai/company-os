{
  "name": "company-os-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app:create": "tsx tools/create-app.ts",
    "build": "turbo run build",
    "check": "turbo run lint typecheck db:check model:check format:check deadcode && turbo boundaries",
    "deadcode": "knip",
    "deploy": "turbo run deploy --filter=\"./apps/*\"",
    "dev": "turbo run dev --filter=\"./apps/*\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "reset": "turbo run reset --filter=\"./apps/*\"",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@continual/cli": "catalog:",
    "@effect/tsgo": "0.38.0",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.12",
    "turbo": "2.10.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "knip": {
    "ignore": [
      "fixtures/**"
    ]
  }
}
