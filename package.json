{
  "name": "company-os-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck db:check model:check format:check deadcode",
    "db:check": "pnpm --filter company-os db:check",
    "db:migrate": "pnpm --filter company-os db:migrate",
    "db:reset": "pnpm --filter company-os db:reset",
    "db:seed": "turbo run db:seed --filter=company-os --",
    "deadcode": "knip",
    "deploy": "turbo run deploy --filter=\"./apps/*\"",
    "dev": "turbo run dev --filter=\"./apps/*\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:readme-banner": "node tools/generate-banner.mjs",
    "kernel:drift": "tsx tools/kernel-drift.ts",
    "lint": "turbo run lint",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "test": "turbo run test",
    "test:migrations": "pnpm --filter company-os test:migrations",
    "ui:add": "pnpm --filter @company/ui ui:add --",
    "ui:remove": "pnpm --filter @company/ui ui:remove --",
    "upstream:merge": "git fetch upstream && git merge upstream/main"
  },
  "devDependencies": {
    "@continual/cli": "catalog:",
    "@effect/tsgo": "0.38.0",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.12",
    "turbo": "2.10.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": "^24.14.0 || >=25.4.0",
    "pnpm": ">=11.0.0"
  },
  "knip": {
    "ignoreBinaries": [
      "pg_dump"
    ],
    "ignore": [
      "fixtures/**"
    ],
    "workspaces": {
      "apps/company-os": {
        "entry": [
          "src/runtime/model/index.ts",
          "src/runtime/server/index.ts",
          "src/runtime/ui/module.ts",
          "src/runtime/access/model/index.ts",
          "src/runtime/platform/model/index.ts",
          "src/modules/*/{model,server,ui,seeds}/index.ts"
        ]
      }
    }
  }
}
