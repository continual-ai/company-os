{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.app.json",
    "tsconfig.base.json",
    "tsconfig.react.json"
  ],
  "tasks": {
    "//#deadcode": {},
    "//#format:check": {},
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_CLIENT_PORTAL_URL", "VITE_COMPANY_OS_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**", "!dist/**/.dev.vars"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "typecheck": {},
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tools/oxlint/company-os/**/*.ts"
      ]
    },
    "test": {},
    "dev": {
      "cache": false,
      "env": ["VITE_CLIENT_PORTAL_URL", "VITE_COMPANY_OS_URL"],
      "passThroughEnv": [
        "APP_SECRET",
        "AUTH_*",
        "CONTINUAL_*",
        "DATABASE_MAX_CONNECTIONS",
        "DATABASE_SCHEMA",
        "DATABASE_URL"
      ],
      "persistent": true
    }
  }
}
