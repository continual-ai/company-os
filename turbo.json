{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.app.json",
    "tsconfig.base.json",
    "tsconfig.react.json"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_CLIENT_PORTAL_URL", "VITE_COMPANY_OS_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "env": ["VITE_CLIENT_PORTAL_URL", "VITE_COMPANY_OS_URL"],
      "persistent": true
    }
  }
}
