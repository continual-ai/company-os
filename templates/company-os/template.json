{
  "id": "company-os",
  "scripts": {
    "build": "vite build",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:deploy": "tsx --env-file-if-exists=.env.local src/server/database/deploy.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:custom": "drizzle-kit generate --custom --config drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/database/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local src/server/database/reset.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/server/database/seed.ts",
    "dev": "vite dev --port 3002",
    "preview": "vite preview --port 3102",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "environmentExample": ".env.example",
  "bootstrapCommands": [
    ["docker", "compose", "up", "-d", "--wait", "postgres"],
    ["pnpm", "--filter", "company-os", "db:deploy"],
    ["pnpm", "--filter", "company-os", "db:seed"],
    ["pnpm", "--filter", "company-os", "typecheck"]
  ]
}
