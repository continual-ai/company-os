{
  "name": "@company/model",
  "version": "0.0.0",
  "private": true,
  "description": "The browser-safe semantic model.",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#modules/*": "./src/modules/*.ts",
    "#root": "./src/root.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./metadata": "./src/metadata.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "model:check": "tsx tools/lint-model.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@company/runtime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
